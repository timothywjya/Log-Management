# PostgreSQL (lihat docker-compose.yml untuk menjalankan database lokal)
DATABASE_URL="postgresql://logmgmt:logmgmt_password@localhost:5432/logmgmt?schema=public"

# Kunci penanda sesi login. Jangan diisi manual: jalankan `npm run generate:secret`
APP_SECRET_KEY=""

# Layanan login ESS
ESS_URL="http://ess1.indomaret.lan:8070/LoginESSREST.svc/v2/LoginESS"
# "true"  = password diperiksa ke ESS (WAJIB di production)
# "false" = password TIDAK diperiksa, siapa pun dengan NIK 10 digit bisa login (hanya development)
ESS_VERIFY_PASSWORD="false"

# Set "false" jika aplikasi diakses lewat HTTP (bukan HTTPS), kalau tidak browser menolak cookie login
COOKIE_SECURE="false"
